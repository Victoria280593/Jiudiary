DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"

APP_URL="http://localhost:3000"

# SMTP for password reset emails.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=your address, SMTP_PASS=an app password
# (https://myaccount.google.com/apppasswords)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# The first admin can only be created via `npm run db:seed` — the public
# registration form never allows the ADMIN role. Fill these in, run the seed
# once, then you can clear the password.
ADMIN_NAME="Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
