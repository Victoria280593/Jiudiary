# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/front/node_modules
/front/.pnpm-store/
/front/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/front/coverage

# next.js
/front/.next/
/front/out/

# production
/front/build

# .NET
**/bin/
**/obj/
.vs/
**/logs/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
/front/.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/front/prisma/*.db
/front/prisma/*.db-journal

# uploaded avatars
/front/public/avatars/*
!/front/public/avatars/.gitkeep

# local Claude Code settings (machine/session-specific)
.claude/settings.local.json
