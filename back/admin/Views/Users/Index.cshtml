@model IReadOnlyList<UserListItemViewModel>
@{
    ViewData["Title"] = "Пользователи";
    var search = ViewData["Search"] as string;
}
<header class="page-header full-width-page-header">
    <div>
        <span class="eyebrow">Доступ и аккаунты</span>
        <h1>Пользователи</h1>
        <p>Учётные записи JiuDiary и их активность.</p>
    </div>
    <div class="header-actions">
        <div class="header-count"><strong>@Model.Count</strong><span>записей</span></div>
        <a class="primary-button" asp-action="Create">Создать пользователя</a>
    </div>
</header>

<section class="panel users-panel">
    <form class="toolbar" method="get">
        <label class="search-label" for="search">Поиск по логину</label>
        <div class="search-row">
            <input id="search" name="search" value="@search" type="search" placeholder="Например, admin@jiudiary.local" />
            <button class="primary-button compact" type="submit">Найти</button>
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a class="secondary-button" asp-action="Index">Сбросить</a>
            }
        </div>
    </form>
    <div class="table-wrap users-table-wrap">
        <table class="users-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Логин</th>
                    <th>ФИО</th>
                    <th>Пояс</th>
                    <th>Роль</th>
                    <th>Создан</th>
                    <th>Последний вход</th>
                    <th>Смена пароля</th>
                    <th>Статус</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="9" class="table-empty">Пользователи не найдены.</td></tr>
            }
            else
            {
                foreach (var user in Model)
                {
                    <tr>
                        <td data-label="ID"><a class="user-link" asp-action="Details" asp-route-id="@user.Id"><code>@user.Id</code></a></td>
                        <td data-label="Логин" class="login-cell"><a class="user-link" asp-action="Details" asp-route-id="@user.Id">@user.Login</a></td>
                        <td data-label="ФИО">@(string.IsNullOrWhiteSpace(user.FullName) ? "—" : user.FullName)</td>
                        <td data-label="Пояс">
                            @if (string.IsNullOrWhiteSpace(user.Belt))
                            {
                                <span>—</span>
                            }
                            else
                            {
                                <span class="belt-badge belt-@GetBeltClass(user.Belt)">@user.Belt</span>
                            }
                        </td>
                        <td data-label="Роль"><span class="role-badge role-@user.Role.ToLowerInvariant()">@user.Role</span></td>
                        <td data-label="Создан">@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td data-label="Последний вход">@(user.LastLoginAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                        <td data-label="Смена пароля">@(user.LastPasswordChangedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                        <td data-label="Статус"><span class="status @(user.IsActive ? "status-active" : "status-inactive")">@(user.IsActive ? "Активен" : "Отключён")</span></td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

@functions {
    private static string GetBeltClass(string belt) => belt.Trim().ToLowerInvariant() switch
    {
        "белый" or "white" => "white",
        "синий" or "blue" => "blue",
        "фиолетовый" or "purple" => "purple",
        "коричневый" or "brown" => "brown",
        "чёрный" or "черный" or "black" => "black",
        "красный" or "red" => "red",
        "жёлтый" or "желтый" or "yellow" => "yellow",
        _ => "other"
    };
}
