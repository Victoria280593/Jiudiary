@model BackupPageViewModel
@{
    ViewData["Title"] = "Мониторинг";
}

<header class="page-header">
    <div>
        <span class="eyebrow">Состояние данных</span>
        <h1>Мониторинг</h1>
        <p>Резервные копии базы и файлы логов backend.</p>
    </div>
    <div class="header-count"><strong>@FormatBytes(Model.TotalBytes)</strong><span>объём бэкапов</span></div>
</header>

<section class="panel">
    <div class="section-intro">
        <div>
            <h2>Резервные копии базы</h2>
            <p>Размер указан по сжатому файлу, если SQL Server сохраняет это значение.</p>
        </div>
        <nav class="monitor-tabs" aria-label="Мониторинг">
            <a class="monitor-tab active" asp-action="Backups">Бэкапы</a>
            <a class="monitor-tab" asp-action="Logs">Логи</a>
        </nav>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Дата и время</th>
                    <th>Тип</th>
                    <th>Размер</th>
                    <th>Устройство</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="4" class="table-empty">В SQL Server пока нет записей о резервных копиях.</td></tr>
            }
            else
            {
                foreach (var backup in Model.Items)
                {
                    <tr>
                        <td class="date-cell">@backup.BackupDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td><span class="backup-type">@backup.Type</span></td>
                        <td class="size-cell">@FormatBytes(backup.SizeBytes)</td>
                        <td class="device-cell">@(string.IsNullOrWhiteSpace(backup.Device) ? "—" : backup.Device)</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>

@functions {
    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} Б";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.##} КБ";
        if (bytes < 1024L * 1024 * 1024) return $"{bytes / (1024d * 1024):0.##} МБ";
        return $"{bytes / (1024d * 1024 * 1024):0.##} ГБ";
    }
}
