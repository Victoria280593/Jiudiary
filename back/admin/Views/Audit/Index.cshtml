@model IReadOnlyList<AuditLogItemViewModel>
@{
    ViewData["Title"] = "Аудит";
}

<header class="page-header">
    <div>
        <span class="eyebrow">Контроль доступа</span>
        <h1>Аудит</h1>
        <p>Кто входил, какие разделы открывал и какие действия выполнял.</p>
    </div>
    <div class="header-count"><strong>@Model.Count</strong><span>событий</span></div>
</header>

<section class="panel">
    <div class="table-wrap audit-table-wrap">
        <table class="audit-table">
            <thead>
                <tr><th>Дата</th><th>Пользователь</th><th>Событие</th><th>Действие</th><th>Раздел</th><th>Статус</th><th>IP</th></tr>
            </thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="table-empty">Событий аудита пока нет.</td></tr>
            }
            else
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td class="login-cell">@item.ActorLogin</td>
                        <td><span class="audit-event">@item.EventType</span></td>
                        <td>@item.Action</td>
                        <td><code>@item.Path</code></td>
                        <td>@item.StatusCode</td>
                        <td>@(item.IpAddress ?? "—")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
